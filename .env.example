# Copy to .env. docker compose and the Makefile read it.
# Host ports are offset from 5432/6379 so they do not clash with a local Postgres or Redis.
POSTGRES_PORT=5433
REDIS_PORT=6380
POSTGRES_USER=spillway
POSTGRES_PASSWORD=spillway
POSTGRES_DB=spillway

DATABASE_URL=postgres://spillway:spillway@localhost:5433/spillway?sslmode=disable
# Optional. Without it the service starts with rate limits and the exact cache disabled.
REDIS_URL=redis://localhost:6380/0
SPILLWAY_ADDR=:8080
SPILLWAY_ROLE=all
SPILLWAY_CONFIG=config/models.yaml
LOG_LEVEL=info

# Dashboard sign-in. Generate the secret with: openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-to-a-random-32-byte-secret-please
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=change-me-admin
SEED_VIEWER_USER=viewer
SEED_VIEWER_PASSWORD=change-me-viewer
