{
  "$description": "Spillway design tokens, exported from the final design artifact. Each theme follows one design system file in this folder. Keys match the CSS variable names used by the design artifact and by web/src/styles/tokens.css, so a key 'bg' becomes '--bg'. The 'from' field names the token in the source file; 'adapted' marks hues borrowed from the other file because the source file defines no dashboard status set.",
  "version": 1,
  "themes": {
    "dark": {
      "source": "DESIGN-linear.app.md",
      "colorScheme": "dark",
      "color": {
        "bg":          { "value": "#010102", "from": "colors.canvas" },
        "panel":       { "value": "#0f1011", "from": "colors.surface-1" },
        "raised":      { "value": "#141516", "from": "colors.surface-2" },
        "node-bg":     { "value": "#141516", "from": "colors.surface-2" },
        "line":        { "value": "#23252a", "from": "colors.hairline" },
        "line2":       { "value": "#34343a", "from": "colors.hairline-strong" },
        "text":        { "value": "#f7f8f8", "from": "colors.ink" },
        "mute":        { "value": "#d0d6e0", "from": "colors.ink-muted" },
        "subtle":      { "value": "#8a8f98", "from": "colors.ink-subtle" },
        "accent":      { "value": "#5e6ad2", "from": "colors.primary" },
        "accent-ink":  { "value": "#ffffff", "from": "colors.on-primary" },
        "accent-hover":{ "value": "#828fff", "from": "colors.primary-hover" },
        "focus":       { "value": "#5e69d1", "from": "colors.primary-focus" },
        "ok":          { "value": "#27a644", "from": "colors.semantic-success" },
        "run":         { "value": "#5db8a6", "from": "DESIGN-claude.md colors.accent-teal", "adapted": true },
        "wait":        { "value": "#e8a55a", "from": "DESIGN-claude.md colors.accent-amber", "adapted": true },
        "fail":        { "value": "#c64545", "from": "DESIGN-claude.md colors.error", "adapted": true },
        "sleep":       { "value": "#8a8f98", "from": "colors.ink-subtle" },
        "badge-bg":    { "value": "#141516", "from": "components.status-badge.backgroundColor" },
        "badge-text":  { "value": "#d0d6e0", "from": "components.status-badge.textColor" },
        "code-bg":     { "value": "#141516", "from": "colors.surface-2" },
        "code-text":   { "value": "#f7f8f8", "from": "colors.ink" },
        "code-mute":   { "value": "#d0d6e0", "from": "colors.ink-muted" },
        "code-btn":    { "value": "#0f1011", "from": "colors.surface-1" },
        "s1":          { "value": "#5db8a6", "from": "DESIGN-claude.md colors.accent-teal", "adapted": true },
        "s2":          { "value": "#e8a55a", "from": "DESIGN-claude.md colors.accent-amber", "adapted": true },
        "s3":          { "value": "#8a8f98", "from": "colors.ink-subtle" }
      },
      "type": {
        "ff-title":  "'Inter',system-ui,-apple-system,'Segoe UI',sans-serif",
        "fs-title":  "28px", "fw-title": "600", "ls-title": "-0.6px",
        "fs-brand":  "18px", "ls-brand": "-0.3px",
        "ff-big":    "'Inter',system-ui,-apple-system,'Segoe UI',sans-serif",
        "fs-big":    "28px", "fw-big": "600", "ls-big": "-0.6px",
        "fs-kpi":    "24px",
        "fs-ask":    "22px"
      },
      "badge":  { "py": "2px", "px": "8px", "fs": "12px", "fw": "400" },
      "button": { "h": "34px", "py": "8px", "px": "14px", "radius": "8px" },
      "tab":    { "radius": "9999px" }
    },
    "light": {
      "source": "DESIGN-claude.md",
      "colorScheme": "light",
      "color": {
        "bg":          { "value": "#faf9f5", "from": "colors.canvas" },
        "panel":       { "value": "#faf9f5", "from": "colors.canvas" },
        "raised":      { "value": "#efe9de", "from": "colors.surface-card" },
        "node-bg":     { "value": "#efe9de", "from": "colors.surface-card" },
        "line":        { "value": "#e6dfd8", "from": "colors.hairline" },
        "line2":       { "value": "#e6dfd8", "from": "colors.hairline" },
        "text":        { "value": "#141413", "from": "colors.ink" },
        "mute":        { "value": "#6c6a64", "from": "colors.muted" },
        "subtle":      { "value": "#6c6a64", "from": "colors.muted" },
        "accent":      { "value": "#cc785c", "from": "colors.primary" },
        "accent-ink":  { "value": "#ffffff", "from": "colors.on-primary" },
        "accent-hover":{ "value": "#a9583e", "from": "colors.primary-active" },
        "focus":       { "value": "#cc785c", "from": "colors.primary" },
        "ok":          { "value": "#5db872", "from": "colors.success" },
        "run":         { "value": "#5db8a6", "from": "colors.accent-teal" },
        "wait":        { "value": "#d4a017", "from": "colors.warning" },
        "fail":        { "value": "#c64545", "from": "colors.error" },
        "sleep":       { "value": "#6c6a64", "from": "colors.muted" },
        "badge-bg":    { "value": "#efe9de", "from": "components.badge-pill.backgroundColor" },
        "badge-text":  { "value": "#141413", "from": "components.badge-pill.textColor" },
        "code-bg":     { "value": "#181715", "from": "colors.surface-dark" },
        "code-text":   { "value": "#faf9f5", "from": "colors.on-dark" },
        "code-mute":   { "value": "#a09d96", "from": "colors.on-dark-soft" },
        "code-btn":    { "value": "#252320", "from": "colors.surface-dark-elevated" },
        "s1":          { "value": "#5db8a6", "from": "colors.accent-teal" },
        "s2":          { "value": "#e8a55a", "from": "colors.accent-amber" },
        "s3":          { "value": "#6c6a64", "from": "colors.muted" }
      },
      "type": {
        "ff-title":  "'Cormorant Garamond','Tiempos Headline',Garamond,'Times New Roman',serif",
        "fs-title":  "36px", "fw-title": "500", "ls-title": "-0.02em",
        "fs-brand":  "26px", "ls-brand": "-0.02em",
        "ff-big":    "'Cormorant Garamond','Tiempos Headline',Garamond,'Times New Roman',serif",
        "fs-big":    "32px", "fw-big": "500", "ls-big": "-0.02em",
        "fs-kpi":    "30px",
        "fs-ask":    "28px"
      },
      "badge":  { "py": "4px", "px": "12px", "fs": "13px", "fw": "500" },
      "button": { "h": "40px", "py": "12px", "px": "20px", "radius": "8px" },
      "tab":    { "radius": "8px" }
    }
  },
  "shared": {
    "font": {
      "sans": "'Inter',system-ui,-apple-system,'Segoe UI',sans-serif",
      "mono": "'JetBrains Mono',ui-monospace,'SF Mono',Menlo,monospace",
      "monoRule": "Mono is for IDs, keys, code and tool or model identifiers only. Numbers use Inter with tabular figures."
    },
    "baseFontSize": "14px",
    "radius": { "button": "8px", "input": "8px", "card": "12px", "node-model": "14px", "node-tool": "6px", "pill": "9999px" },
    "spacingBase": "4px",
    "layout": { "sidebar": "240px", "mainPadding": "32px 40px 56px", "contentMax": "none" },
    "focus": "2px solid var(--focus), offset 2px, shown on :focus-visible. Used at full strength, not the half opacity Linear's file lists, for contrast."
  },
  "status": {
    "note": "A run status is a neutral pill with a colored shape and a word. Never color alone. Icons are paths on a 12 by 12 grid, stroke 1.6, round caps.",
    "succeeded": { "label": "Succeeded",            "color": "ok",    "icon": "M2.5 6.5l2.2 2.2L9.5 3.5" },
    "running":   { "label": "Running",              "color": "run",   "icon": "M6 1.5a4.5 4.5 0 1 0 4.5 4.5", "animation": "spin 1.4s linear infinite, off under prefers-reduced-motion" },
    "waiting":   { "label": "Waiting for approval", "color": "wait",  "icon": "M4 2.5v7M8 2.5v7" },
    "sleeping":  { "label": "Sleeping",             "color": "sleep", "icon": "M9.5 7A4 4 0 0 1 5 2.5a4 4 0 1 0 4.5 4.5z" },
    "failed":    { "label": "Failed",               "color": "fail",  "icon": "M3 3l6 6M9 3l-6 6" },
    "cancelled": { "label": "Cancelled",            "color": "sleep", "icon": "M2.5 6h7" },
    "queued":    { "label": "Queued",               "color": "sleep", "icon": "M6 3v3l2 1.2" }
  },
  "stepIcons": {
    "model": "M2 3h8v5.5H6.5L4.5 10.5V8.5H2z",
    "tool":  "M3 9l3.3-3.3M7.2 2.5a2.3 2.3 0 1 0 2.3 2.8L8 5.5 6.5 4z",
    "goal":  "M4 2.5v7l5-3.5z",
    "reissued": "M10 6a4 4 0 1 1-1.2-2.8M10 2.5v2.3H7.7"
  },
  "graph": {
    "note": "Geometry of the run graph in px. Columns are steps in order. Two lanes by step type. Each recovery adds a worker band, a dashed cut line and a horizontal shift.",
    "node": { "w": 90, "h": 80 },
    "colStep": 100,
    "leftGutter": 72,
    "recoveryShift": 30,
    "lane": { "modelTop": 120, "toolTop": 270 },
    "height": 400,
    "fallbackChip": { "top": 62, "h": 44 },
    "edge": { "thickness": 2, "done": "subtle", "running": "run", "reissued": "dashed run" },
    "nodeStates": {
      "finished": "solid border line2, status mark ok",
      "running": "border run, spinning mark",
      "stopped": "1.5px dashed border fail, 6% fail tint, mark fail",
      "reissued": "1.5px dashed border run, mark reissued",
      "selected": "outline 2px focus, offset 3px"
    }
  },
  "chart": {
    "note": "Series colors are the documented accents, not the dataviz default palette. Against the validator: color-blind and normal-vision separation pass; lightness band and chroma floor do not; light-mode contrast is under 3 to 1. Every chart therefore has a legend, hover values and a table.",
    "series": ["s1", "s2", "s3"],
    "semanticCacheTexture": "repeating-linear-gradient(135deg, var(--ok) 0 4px, var(--panel) 4px 6px)",
    "barGap": "2px",
    "barTopRadius": "3px to 4px"
  },
  "knownGaps": [
    "White text on the light theme's coral primary is about 3.3 to 1.",
    "Light-theme hairlines are about 1.3 to 1 against the canvas, so control borders are faint.",
    "The documented chart accents fail the validator's lightness and chroma checks.",
    "Linear's file says not to ship a light page; the light theme follows Claude's file by decision."
  ]
}
